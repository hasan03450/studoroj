# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.

# Public URL of the site, without trailing slash (used for SEO, sitemap and email links)
NEXT_PUBLIC_SITE_URL=https://www.studuroj.nl

# Sanity (sanity.io/manage → your project)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Secret shared with the Sanity webhook that refreshes the site after an edit
SANITY_REVALIDATE_SECRET=

# Email via Resend (resend.com). Verify your domain there first.
RESEND_API_KEY=
EMAIL_FROM="StuduRoj <noreply@studuroj.nl>"
# Where contact messages and new member sign-ups are sent
EMAIL_TO_BOARD=info@studuroj.nl

# Random secret (32+ characters) used to encrypt membership confirmation links.
# Generate one with: openssl rand -base64 32
MEMBERSHIP_TOKEN_SECRET=

# Newsletter via Brevo (brevo.com) – optional
BREVO_API_KEY=
BREVO_LIST_ID=
# Template id for Brevo's double opt-in email (recommended under GDPR)
BREVO_DOI_TEMPLATE_ID=

# Spam protection via Cloudflare Turnstile – optional but recommended
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
